# 将需要的变量设置到 ARTEX 进程环境。启动脚本不加载 .env 文件。
# PostgreSQL 连接（可改用 config.json）
ARTEX_PG_DSN=

# 私有 GitHub Release 更新（仅后端读取，令牌需 Hinln/ARTEX 的 Contents 读取权限）
ARTEX_UPDATE_GITHUB_TOKEN=

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
