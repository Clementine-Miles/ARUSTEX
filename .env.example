# Export the variables needed by ARTEX. The startup script does not load .env.
# PostgreSQL connection (config.toml is also supported).
ARTEX_PG_DSN=
ARTEX_CONFIG=
ARTEX_SKILL_DIR=

# Set the API keys for the providers you use, or configure them in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
